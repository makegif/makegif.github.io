---
import { defaultLang, type SupportedLanguage } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-12 border-t border-warmBorder dark:border-slate-800/80">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-amber-50/60 via-ivory to-sage/10 dark:from-slate-900 dark:via-slate-900/80 dark:to-slate-900 border border-warmBorder dark:border-slate-800 p-8 sm:p-12 shadow-sm">
      <!-- Background decorative circle -->
      <div class="absolute -top-24 -right-24 w-64 h-64 rounded-full bg-[#FFDD00]/10 blur-3xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-8 text-center md:text-left">
        <div class="max-w-xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FFDD00]/20 text-amber-900 dark:text-amber-300 text-xs font-semibold mb-4">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20 3H4v10c0 2.21 1.79 4 4 4h6c2.21 0 4-1.79 4-4v-3h2c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 5h-2V5h2v3zM4 19h16v2H4z" />
            </svg>
            <span>Open Source & Free</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
            {t('support.title')}
          </h3>
          <p class="mt-2 text-sm sm:text-base text-slate-600 dark:text-slate-300">
            {t('support.subtitle')}
          </p>
        </div>

        <div class="shrink-0">
          <a
            href="https://buymeacoffee.com/kisharadilz"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 bg-[#FFDD00] text-black hover:bg-[#FFDD00]/90 font-bold text-base rounded-xl px-6 py-3.5 shadow-md hover:shadow-lg transition-all hover:scale-105 active:scale-95 focus:outline-none focus:ring-4 focus:ring-[#FFDD00]/40"
          >
            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20 3H4v10c0 2.21 1.79 4 4 4h6c2.21 0 4-1.79 4-4v-3h2c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 5h-2V5h2v3zM4 19h16v2H4z" />
            </svg>
            <span>{t('support.btn')}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
