---
import { defaultLang, type SupportedLanguage } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const features = [
  {
    title: t('features.f1Title'),
    desc: t('features.f1Desc'),
    icon: 'shield',
  },
  {
    title: t('features.f2Title'),
    desc: t('features.f2Desc'),
    icon: 'palette',
  },
  {
    title: t('features.f3Title'),
    desc: t('features.f3Desc'),
    icon: 'cpu',
  },
  {
    title: t('features.f4Title'),
    desc: t('features.f4Desc'),
    icon: 'sparkles',
  },
];
---

<section id="features" class="py-16 sm:py-24 border-t border-warmBorder dark:border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {t('features.title')}
      </h2>
      <p class="mt-3 text-base sm:text-lg text-slate-600 dark:text-slate-300">
        {t('features.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {features.map((item) => (
        <div class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-slate-900/70 border border-warmBorder dark:border-slate-800 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-xl bg-sage/15 dark:bg-sage/20 text-sage dark:text-sage-300 flex items-center justify-center mb-5">
              {item.icon === 'shield' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              )}
              {item.icon === 'palette' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4 7 7 0 017-7 7 7 0 017 7 4 4 0 01-4 4h-6zM15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              )}
              {item.icon === 'cpu' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              )}
              {item.icon === 'sparkles' && (
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                </svg>
              )}
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white mb-2">
              {item.title}
            </h3>
            <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
              {item.desc}
            </p>
          </div>
          <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-800/60 flex items-center gap-2 text-xs font-semibold text-sage">
            <span>MakeGIF Guarantee</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
