---
import { defaultLang, supportedLanguages, type SupportedLanguage } from '../i18n/ui';
import { getLocalizedPath, useTranslations } from '../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
const currentPath = Astro.url.pathname;
---

<footer class="border-t border-warmBorder dark:border-slate-800 bg-white/50 dark:bg-slate-950 text-slate-600 dark:text-slate-400 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <!-- Col 1: Brand & Mission -->
      <div class="md:col-span-2 space-y-4">
        <a href={getLocalizedPath('/', lang)} class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-sage flex items-center justify-center text-white font-black text-xs">
            <span>GIF</span>
          </div>
          <span class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">
            Make<span class="text-sage">GIF</span>
          </span>
        </a>
        <p class="text-sm leading-relaxed max-w-sm text-slate-500 dark:text-slate-400">
          {t('footer.tagline')}
        </p>
        <div class="inline-flex items-center gap-2 text-xs font-semibold px-3 py-1.5 rounded-lg bg-sage/10 text-sage dark:bg-sage/20 dark:text-sage-300">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <span>{t('footer.privacy')}</span>
        </div>
      </div>

      <!-- Col 2: Navigation -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-3">
          {t('footer.navigation')}
        </h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="#features" class="hover:text-sage dark:hover:text-sage-300 transition-colors">
              {t('nav.features')}
            </a>
          </li>
          <li>
            <a href="#how-it-works" class="hover:text-sage dark:hover:text-sage-300 transition-colors">
              {t('nav.howItWorks')}
            </a>
          </li>
          <li>
            <a href="#faq" class="hover:text-sage dark:hover:text-sage-300 transition-colors">
              {t('nav.faq')}
            </a>
          </li>
          <li>
            <a
              href="https://buymeacoffee.com/kisharadilz"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-amber-600 dark:hover:text-amber-400 transition-colors inline-flex items-center gap-1"
            >
              <span>{t('cta.buyCoffee')}</span>
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Languages -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white mb-3">
          {t('nav.language')}
        </h4>
        <ul class="grid grid-cols-2 gap-2 text-sm">
          {(Object.keys(supportedLanguages) as SupportedLanguage[]).map((langKey) => (
            <li>
              <a
                href={getLocalizedPath(currentPath, langKey)}
                class={`hover:text-sage dark:hover:text-sage-300 transition-colors flex items-center gap-1.5 ${
                  langKey === lang ? 'font-bold text-sage' : ''
                }`}
              >
                <span>{supportedLanguages[langKey].flag}</span>
                <span>{supportedLanguages[langKey].name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-warmBorder/60 dark:border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
      <p>
        © {currentYear} MakeGIF. {t('footer.rights')}
      </p>
      <p class="flex items-center gap-1">
        <span>{t('footer.builtWith')}</span>
      </p>
    </div>
  </div>
</footer>
