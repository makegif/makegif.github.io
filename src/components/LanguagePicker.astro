---
import { defaultLang, supportedLanguages, type SupportedLanguage } from '../i18n/ui';
import { getLocalizedPath, useTranslations } from '../i18n/utils';

interface Props {
  currentLang: SupportedLanguage;
}

const { currentLang = defaultLang } = Astro.props;
const currentPath = Astro.url.pathname;
const t = useTranslations(currentLang);
---

<div class="relative inline-block text-left" id="lang-picker-container">
  <button
    id="lang-picker-button"
    type="button"
    class="inline-flex items-center justify-center w-10 h-10 lg:w-auto lg:px-3 lg:py-2 text-sm font-medium rounded-lg border border-warmBorder dark:border-slate-800 bg-white/80 dark:bg-slate-900/80 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors focus:outline-none focus:ring-2 focus:ring-sage"
    aria-expanded="false"
    aria-haspopup="true"
    title={t('nav.language')}
  >
    <span class="text-base leading-none">{supportedLanguages[currentLang].flag}</span>
    <span class="hidden lg:inline text-slate-800 dark:text-slate-200 ml-2">{supportedLanguages[currentLang].name}</span>
    <svg
      class="hidden lg:block w-4 h-4 text-slate-500 ml-1.5 transition-transform duration-200"
      id="lang-chevron"
      viewBox="0 0 20 20"
      fill="currentColor"
    >
      <path
        fill-rule="evenodd"
        d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
        clip-rule="evenodd"
      />
    </svg>
  </button>

  <div
    id="lang-dropdown"
    class="hidden absolute right-0 mt-2 w-48 rounded-xl shadow-xl border border-warmBorder dark:border-slate-800 bg-white dark:bg-slate-900 py-1.5 z-50 focus:outline-none ring-1 ring-black/5"
    role="menu"
    aria-orientation="vertical"
    aria-labelledby="lang-picker-button"
  >
    {(Object.keys(supportedLanguages) as SupportedLanguage[]).map((langKey) => {
      const isCurrent = langKey === currentLang;
      const targetUrl = getLocalizedPath(currentPath, langKey);
      const item = supportedLanguages[langKey];

      return (
        <a
          href={targetUrl}
          role="menuitem"
          class={`flex items-center justify-between px-4 py-2.5 text-sm transition-colors ${
            isCurrent
              ? 'bg-sage/15 text-sage-800 dark:text-sage-300 font-semibold'
              : 'text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800'
          }`}
        >
          <span class="flex items-center gap-2.5">
            <span class="text-base leading-none">{item.flag}</span>
            <span>{item.name}</span>
          </span>
          {isCurrent && (
            <svg class="w-4 h-4 text-sage" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          )}
        </a>
      );
    })}
  </div>
</div>

<script is:inline>
  (() => {
    const container = document.getElementById('lang-picker-container');
    const button = document.getElementById('lang-picker-button');
    const dropdown = document.getElementById('lang-dropdown');
    const chevron = document.getElementById('lang-chevron');

    function toggleDropdown() {
      const isExpanded = button?.getAttribute('aria-expanded') === 'true';
      button?.setAttribute('aria-expanded', String(!isExpanded));
      dropdown?.classList.toggle('hidden');
      chevron?.classList.toggle('rotate-180');
    }

    function closeDropdown() {
      button?.setAttribute('aria-expanded', 'false');
      dropdown?.classList.add('hidden');
      chevron?.classList.remove('rotate-180');
    }

    button?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleDropdown();
    });

    document.addEventListener('click', (e) => {
      if (container && !container.contains(e.target)) {
        closeDropdown();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeDropdown();
      }
    });
  })();
</script>
